  "supplemental_protocols": [
    {
      "id": "training-ablations",
      "status": "runnable_prospective",
      "source": "scripts/run_training_matrix.py",
      "command": [
        ".venv/bin/python",
        "scripts/run_training_matrix.py",
        "--config",
        "configs/training/prospective/game24.yaml",
        "--methods",
        "sft",
        "gvo",
        "rloo",
        "grpo",
        "no_p",
        "item_reward",
        "outer_blind",
        "inner_blind",
        "evidence_blind",
        "additive",
        "blind_additive",
        "--seeds",
        "0",
        "1",
        "2",
        "3",
        "4",
        "5",
        "6",
        "7",
        "--plan"
      ],
      "execute_switch": "Replace --plan with --execute",
      "note": "Eight separately trained replicas; new training data/seeds, no author-checkpoint equivalence."
    },
    {
      "id": "recursion-reset-retain",
      "status": "runnable_prospective",
      "command": [
        ".venv/bin/python",
        "scripts/run_transfer.py",
        "--config",
        "configs/transfer/recursion_reset_retain.yaml",
        "--plan"
      ],
      "execute_switch": "Remove --plan",
      "note": "Paired reset/retain across three rounds with fresh result ledgers; fixed improver."
    },
    {
      "id": "cross-family",
      "status": "runnable_prospective",
      "command": [
        ".venv/bin/python",
        "scripts/run_transfer.py",
        "--config",
        "configs/transfer/cross_family.yaml",
        "--plan"
      ],
      "execute_switch": "Remove --plan",
      "note": "Arithmetic to QA to planning; carry only frozen task-agent artifacts."
    },
    {
      "id": "learned-recursion",
      "status": "runnable_prospective",
      "command": [
        ".venv/bin/python",
        "scripts/run_transfer.py",
        "--config",
        "configs/transfer/learned_recursion_training.yaml",
        "--plan"
      ],
      "execute_switch": "Remove --plan",
      "note": "Actual development training between rounds; explicitly registered pilot schedule, not original learned trajectory."
    },
    {
      "id": "nested_training_8x12",
      "status": "runnable_prospective",
      "command": [
        ".venv/bin/python",
        "scripts/run_ablations.py",
        "--config",
        "configs/experiments/prospective_ablations.json",
        "--plan"
      ],
      "execute_switch": "Replace --plan with --execute",
      "note": "Five source-named training methods, eight independent training replicas each and 12 nested actual searches per replica; new Reactor task cohort. Optional observation controls are separate."
    },
    {
      "id": "task-model-grpo",
      "status": "runnable_prospective",
      "command": [
        ".venv/bin/python",
        "scripts/run_task_grpo.py",
        "--config",
        "configs/training/task_grpo/hotpotqa.yaml",
        "--plan"
      ],
      "execute_switch": "Replace --plan with --execute",
      "other_registered_tasks": [
        "ifbench",
        "hover",
        "pupa",
        "aime25",
        "livebench_math"
      ],
      "note": "Updates the task-generation LoRA; SpecRSI role-GRPO and task-model GRPO are different permissions and endpoints. Selection chooses a checkpoint before held-out audit."
    },
    {
      "id": "paired-frozen-state-interventions",
      "status": "conditional_on_real_observed_state_cohorts",
      "command": [
        ".venv/bin/python",
        "scripts/run_ablations.py",
        "--prepare-pairs"
      ],
      "execute_command": [
        ".venv/bin/python",
        "scripts/run_ablations.py",
        "--execute-pairs"
      ],
      "requires": {
        "outer_pairs": 120,
        "batch_pairs": 120,
        "source": "Completed nested searches with matching frozen legal support and receiver checkpoint hashes"
      },
      "note": "No fabricated states or original optimal-action labels. Insufficient compatible real states are explicitly counted, not marked complete."
    }
  ],
