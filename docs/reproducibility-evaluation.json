        "answer_em",
        "supporting_facts_em",
        "supporting_facts_f1",
        "joint_em",
        "joint_f1"
      ],
      "normalization": "Lowercase; remove punctuation and articles; token-frequency overlap for precision and recall"
    },
    "hover": {
      "metric": "gold_supporting_document_coverage",
      "retrieval_top_k": [
        7,
        7,
        10
      ],
      "pipeline_model_calls": {
        "summary": 2,
        "query": 2
      }
    },
    "ifbench": {
      "metric": "prompt_loose",
      "levels": [
        "prompt",
        "instruction"
      ],
      "variants": [
        "strict",
        "loose"
      ],
      "revision": "1c40f0c10d9b5c5c2f10a175a28007ebb64f7f4d"
    },
    "pupa": {
      "metric": "(quality + 1 - leakage) / 2",
      "model_calls": 6,
      "stages": [
        "redact",
        "untrusted_answer",
        "private_answer",
        "quality_judge_order_1",
        "quality_judge_order_2",
        "leakage_judge"
      ]
    },
    "aime": {
      "metric": "integer_exact_match",
      "answer_range": [
        0,
        999
      ],
      "extraction": "Last balanced boxed/fbox, explicit answer line, or complete-text integer answer"
    },
    "livebench_math": {
      "metric": "native task-specific scorer",
      "harness_revision": "0edef1710338da97d78e071e3c3ac06426a937a8",
      "tasks": [
        "AMC/AIME",
        "proof rearrangement",
        "AMPS"
      ],
      "fallback_metric": "Separately named local-judge metric"
    },
    "math": {
      "metric": "AFlow native numeric/symbolic equivalence",
      "sandbox_timeout_seconds": 20,
      "sandbox_memory_mib": 2048
    },
    "game24": {
      "metric": "exact rational arithmetic equals 24",
      "input_use": "Each input number exactly once, preserving multiplicity",
      "operators": [
        "+",
        "-",
        "*",
        "/",
        "parentheses"
      ]
    },
    "mbpp": {
      "metric": "complete test_list execution"
    },
    "planbench": {
      "track": "prospective_zero_shot_plan_generation",
      "metric": "Complete plan satisfies PDDL transitions, preconditions and goals"
    },
    "polyglot": {
      "metric": "native language-specific tests",
      "runtimes": [
        "pytest",
        "Jest",
        "Go",
        "Cargo",
        "CMake+Catch",
        "JUnit"
      ]
    },
    "swe": {
      "metric": "official harness per-instance resolved",
      "instance_identity": [
        "base_commit",
        "OCI image digest",
        "test commands",
        "timeout"
      ]
    }
  },
