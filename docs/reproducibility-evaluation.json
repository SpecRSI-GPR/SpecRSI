    },
    "mbpp": {
      "instruction": "Write Python code implementing the requested function. Return only the code without markdown.",
      "configuration": "configs/experiments/prospective/mbpp.yaml"
    },
    "planbench": {
      "instruction": "Return a complete valid plan using only the exact action names and objects in the task. Put one action on each line; do not include explanations.",
      "configuration": "configs/experiments/prospective/planbench.yaml"
    },
